{
  "rules": [
    {
      "pattern": "job:[0-9a-f-]{36}:[0-9a-f-]{36}:read:(src_[a-z][a-z0-9_]*)",
      "user": "$1"
    },
    {
      "pattern": "job:[0-9a-f-]{36}:[0-9a-f-]{36}:extract:([a-z][a-z0-9_]*)",
      "user": "_$1"
    },
    { "pattern": "job:.*|src_.*|_.*", "allow": false },
    { "pattern": "(.*)", "user": "$1" }
  ]
}
