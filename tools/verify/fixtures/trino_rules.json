{
  "catalogs": [
    { "user": ".*@.*", "catalog": "system", "allow": "read-only" },
    { "user": ".*@.*", "allow": "none" },
    { "user": "src_[a-z][a-z0-9_]*", "catalog": "{user}", "allow": "read-only" },
    { "user": "_loans", "catalog": "src_beta", "allow": "read-only" },
    { "user": "_loans", "catalog": "lake", "allow": "all" },
    { "user": "_orders", "catalog": "src_alpha", "allow": "read-only" },
    { "user": "_orders", "catalog": "lake", "allow": "all" },
    { "user": "qd-api", "allow": "owner" },
    { "allow": "none" }
  ],
  "schemas": [{ "user": "qd-api", "owner": true }],
  "tables": [
    {
      "user": "qd-api",
      "privileges": ["SELECT", "INSERT", "DELETE", "UPDATE", "OWNERSHIP", "GRANT_SELECT"]
    },
    { "user": ".*@.*", "catalog": "system", "privileges": ["SELECT"] },
    { "user": "src_[a-z][a-z0-9_]*", "catalog": "{user}", "privileges": ["SELECT"] },
    { "user": "_loans", "catalog": "src_beta", "privileges": ["SELECT"] },
    {
      "user": "_loans",
      "catalog": "lake",
      "schema": "loans_bronze",
      "privileges": ["SELECT", "INSERT", "DELETE", "OWNERSHIP"]
    },
    { "user": "_orders", "catalog": "src_alpha", "privileges": ["SELECT"] },
    {
      "user": "_orders",
      "catalog": "lake",
      "schema": "orders_bronze",
      "privileges": ["SELECT", "INSERT", "DELETE", "OWNERSHIP"]
    }
  ],
  "queries": [
    { "user": ".*@.*", "allow": ["view", "kill"] },
    { "user": "qd-api", "allow": ["execute", "view", "kill"] },
    { "user": "src_[a-z][a-z0-9_]*|_[a-z][a-z0-9_]*", "allow": ["execute"] }
  ],
  "system_information": [
    { "user": ".*@.*", "allow": ["read"] },
    { "user": "qd-api", "allow": ["read", "write"] }
  ]
}
